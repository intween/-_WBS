# 저장소 모드: local | http | supabase
#   local    - 브라우저 localStorage (기본값, 혼자 쓸 때)
#   http     - 직접 만든 REST API
#   supabase - Supabase Postgres (팀 공유 + 실시간 동기화)
VITE_STORE_MODE=local

# http 모드에서만 사용
VITE_API_BASE_URL=http://localhost:8000/api

# supabase 모드에서만 사용
# Supabase 대시보드 > Project Settings > API Keys 에서 확인
# VITE_SUPABASE_KEY 에는 publishable key(sb_publishable_...) 를 넣습니다.
# secret key(sb_secret_...) 는 절대 넣지 마세요. 브라우저에 그대로 노출됩니다.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxx
